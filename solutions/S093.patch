diff --git a/tools/gen_manifest.py~scenario_S093_target b/tools/gen_manifest.py~scenario_S093_target
new file mode 100644
index 0000000..597c791
--- /dev/null
+++ b/tools/gen_manifest.py~scenario_S093_target
@@ -0,0 +1,26 @@
+"""Regenerates generated/manifest.json: a digest per policy rule in erpkit/rules.py.
+
+Run from the repository root:  python tools/gen_manifest.py
+"""
+import ast
+import hashlib
+import json
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent  # repo root
+
+
+def build(source):
+    tree = ast.parse(source)
+    lines = source.splitlines(keepends=True)
+    digests = {}
+    for node in tree.body:
+        if isinstance(node, ast.FunctionDef):
+            text = "".join(lines[node.lineno - 1:node.end_lineno])
+            digests[node.name] = hashlib.sha256(text.encode()).hexdigest()[:12]
+    return json.dumps({"generated_by": "tools/gen_manifest.py", "rules": digests}, indent=2, sort_keys=True) + "\n"
+
+
+if __name__ == "__main__":
+    src = (ROOT / "erpkit" / "rules.py").read_text()
+    (ROOT / "generated" / "manifest.json").write_text(build(src))
